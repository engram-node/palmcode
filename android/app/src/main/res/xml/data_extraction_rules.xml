<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" already blocks adb/cloud backup. These rules additionally
  block device-to-device transfer (API 31+) for everything: API keys,
  session DBs and workspaces never leave this device (AGENTS.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
